# ==========================================
# Discord ICT Contest Bot - Environment Config
# ==========================================

# [Required for Discord Alerts]
# Discord 채널 설정 > 연동 > 웹후크 생성 후 복사한 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# [Recommended for AI Search & Refinement]
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 Gemini API 키
# 미설정 시 공개 공고 웹 목록(Wevity 등) 기반 폴백 수집기로 자동 동작합니다.
GEMINI_API_KEY=your_gemini_api_key_here

# [Optional Settings]
# Gemini 무료 티어 권장 모델: gemini-2.5-flash 또는 gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# 알림 기준 시간대 (기본: Asia/Seoul)
TZ=Asia/Seoul

# 마감 임박 알림 단계 (일 단위 쉼표 구분, 기본: 7,3,1)
ALERT_DAYS=7,3,1

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
